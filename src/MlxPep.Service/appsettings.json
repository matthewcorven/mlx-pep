{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AzureBlobStorage": ""
  },
  "RateLimit": {
    "DefaultLimit": 100,
    "WindowSizeSeconds": 60,
    "BypassLocalhost": true,
    "RespectXForwardedFor": true
  },
  "Blocking": {
    "EnableIpBlocking": false,
    "EnableCidrBlocking": false,
    "EnableHostnameBlocking": false,
    "BlockedIps": [],
    "BlockedCidrs": [],
    "BlockedHostnames": []
  }
}

